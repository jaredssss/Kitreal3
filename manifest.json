{
  "manifest_version": 3,
  "name": "Kitreal Capture",
  "description": "Capture full-page screenshots with free and premium workflows.",
  "version": "1.0.0",
  "permissions": ["activeTab", "downloads", "scripting", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Kitreal Capture",
    "default_popup": "popup.html"
  }
}
